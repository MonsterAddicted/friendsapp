{
  // Cloudflare Worker config. The name must match the Worker name in the Cloudflare dashboard.
  "name": "friendsapp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
